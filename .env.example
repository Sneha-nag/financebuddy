# Optional AWS (upload, Athena dbt, live Streamlit backends)
AWS_PROFILE=default
AWS_REGION=us-east-1
FINANCEBUDDY_S3_BUCKET=your-financebuddy-bucket
FINANCEBUDDY_ATHENA_SCHEMA=financebuddy
FINANCEBUDDY_ATHENA_S3_STAGING=s3://your-financebuddy-bucket/athena-results/
FINANCEBUDDY_ATHENA_MARTS_SCHEMA=marts
FINANCEBUDDY_ATHENA_WORKGROUP=primary

# Streamlit data backend: duckdb | s3 | athena
FINANCEBUDDY_BACKEND=duckdb

# Set to enable password gate on the live demo
# FINANCEBUDDY_APP_PASSWORD=change-me

# Optional streaming demo (Kinesis → Firehose → S3)
# FINANCEBUDDY_KINESIS_STREAM=financebuddy-txns
# FINANCEBUDDY_FIREHOSE_STREAM=financebuddy-txns-to-s3
# FINANCEBUDDY_FIREHOSE_ROLE=financebuddy-firehose-role
# FINANCEBUDDY_STREAM_S3_PREFIX=financebuddy/raw/stream/

# Optional Bedrock Claude coach (see docs/coach.md)
# FINANCEBUDDY_COACH_ENABLED=1
# FINANCEBUDDY_BEDROCK_MODEL=us.anthropic.claude-haiku-4-5-20251001-v1:0
# FINANCEBUDDY_COACH_DAILY_LIMIT=30
